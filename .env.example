# Portfolio Assistant — optional AI backend
#
# If this is set (in your Vercel project's Environment Variables,
# NOT in this file, and NOT committed to git), the chatbot will use
# real Claude-powered answers via /api/chat.
#
# If it's left unset, the chatbot automatically falls back to its
# built-in demo mode (chatbot/chatbot-engine.js) — fully functional,
# no API key required.

ANTHROPIC_API_KEY=your_api_key_here

# Contact form (api/contact.js) -> sends messages to your inbox via Resend
RESEND_API_KEY=your_resend_api_key_here
# Optional. Defaults to deandrawahyudrian15@gmail.com
CONTACT_TO_EMAIL=deandrawahyudrian15@gmail.com
